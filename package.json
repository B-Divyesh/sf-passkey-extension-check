{
  "name": "passkey-extension-check",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite site",
    "prepare:wxt": "wxt prepare",
    "postinstall": "npm run prepare:wxt",
    "pretest": "npm run prepare:wxt",
    "precheck": "npm run prepare:wxt",
    "test": "vitest run",
    "test:clean-gate": "node scripts/verify-clean-gate.mjs",
    "test:a11y": "xvfb-run -a env EXTENSION_HEADED=1 node scripts/verify-ui.mjs",
    "test:claims": "npm run build && xvfb-run -a node scripts/verify-claims.mjs",
    "build:extension": "wxt build",
    "build:web": "vite build --config site/vite.config.ts",
    "build:site": "npm run build:extension && npm run build:web && npm run package:extension",
    "package:extension": "node scripts/package-extension.mjs",
    "build": "npm run build:site",
    "check": "npm run test:clean-gate && npm run build && npm run test:a11y && npm run test:claims"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
